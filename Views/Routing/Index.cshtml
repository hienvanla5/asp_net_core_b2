@{
    ViewData["Title"] = "Conventional Routing";
}

<h1>Conventional Routing</h1>
<p>
    Route được khai báo <strong>một lần</strong> trong <code>Program.cs</code>.
    Sau đó URL được ánh xạ tới controller/action theo đúng thứ tự các đoạn trong pattern.
</p>

<pre class="bg-light border p-3"><code>app.MapControllerRoute(
    name: "conventional-demo",
    pattern: "conventional/{action=Index}/{id?}",
    defaults: new { controller = "Routing" });</code></pre>

<p>Pattern trên có nghĩa:</p>
<table class="table table-bordered" style="max-width: 860px">
    <thead>
        <tr>
            <th>Đoạn URL</th>
            <th>Ý nghĩa</th>
            <th>Ví dụ</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><code>conventional</code></td>
            <td>Tiền tố cố định</td>
            <td><code>/conventional/...</code></td>
        </tr>
        <tr>
            <td><code>{action=Index}</code></td>
            <td>Tên action, mặc định là <code>Index</code></td>
            <td><code>about</code> → <code>About()</code></td>
        </tr>
        <tr>
            <td><code>{id?}</code></td>
            <td>Tham số tùy chọn, tự bind vào tham số <code>int id</code></td>
            <td><code>details/2</code> → <code>id = 2</code></td>
        </tr>
        <tr>
            <td><code>defaults</code></td>
            <td>Controller mặc định là <code>RoutingController</code></td>
            <td>URL không cần chữ "Routing"</td>
        </tr>
    </tbody>
</table>

<h2>Bảng ánh xạ URL</h2>
<table class="table table-bordered" style="max-width: 860px">
    <thead>
        <tr>
            <th>URL</th>
            <th>Action được gọi</th>
        </tr>
    </thead>
    <tbody>
        <tr><td><code>/conventional</code></td><td><code>RoutingController.Index()</code></td></tr>
        <tr><td><code>/conventional/about</code></td><td><code>RoutingController.About()</code></td></tr>
        <tr><td><code>/conventional/details/2</code></td><td><code>RoutingController.Details(2)</code></td></tr>
    </tbody>
</table>

<h2>Thử ngay</h2>
<div class="d-flex flex-wrap gap-2">
    <a class="btn btn-primary" href="/conventional/details/2">/conventional/details/2</a>
    <a class="btn btn-outline-primary" href="/conventional/details/99">id không tồn tại</a>
    <a class="btn btn-outline-secondary" href="/conventional/about">/conventional/about</a>
</div>

<p class="mt-3 mb-0">
    URL hiện tại: <code>@Context.Request.Path</code>
</p>

<p class="mt-3">
    <a asp-controller="Demo" asp-action="Index">← Quay lại danh sách demo</a>
</p>
