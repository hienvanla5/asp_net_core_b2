@model IReadOnlyList<Movie>

@{
    ViewData["Title"] = "Attribute Routing - Genre";
}

<h1>Phim theo thể loại</h1>
<p>
    URL <code>/attribute/genre/Drama</code> khớp với
    <code>[HttpGet("genre/{genre:alpha}")]</code>.
    Giá trị <code>Drama</code> được bind vào tham số <code>string genre</code>.
</p>

<p>Thể loại đang xem: <strong>@ViewData["Genre"]</strong></p>
<p>URL hiện tại: <code>@Context.Request.Path</code></p>

@if (Model.Count == 0)
{
    <div class="alert alert-warning">Không có phim nào thuộc thể loại này.</div>
}
else
{
    <div class="row">
        @foreach (var movie in Model)
        {
            <div class="col-md-4">
                <partial name="_MovieCard" model="movie" />
            </div>
        }
    </div>
}

<a asp-controller="AttributeRouting" asp-action="Index">← Quay lại giải thích</a>
