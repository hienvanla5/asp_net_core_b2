@{
    ViewData["Title"] = "Attribute Routing";
}

<h1>Attribute Routing</h1>
<p>
    Route được khai báo <strong>ngay trên controller và action</strong> bằng attribute.
    Không cần sửa <code>Program.cs</code> khi thêm URL mới.
</p>

<pre class="bg-light border p-3"><code>[Route("attribute")]
public class AttributeRoutingController : Controller
{
    [HttpGet("")]
    public IActionResult Index() => View();

    [HttpGet("movie/{id:int}")]
    public IActionResult Movie(int id) { ... }

    [HttpGet("genre/{genre:alpha}")]
    public IActionResult Genre(string genre) { ... }

    [HttpGet("year/{year:int:range(1990,2030)}")]
    public IActionResult Year(int year) { ... }
}</code></pre>

<h2>Bảng route</h2>
<table class="table table-bordered" style="max-width: 960px">
    <thead>
        <tr>
            <th>URL</th>
            <th>Attribute</th>
            <th>Ghi chú</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><code>/attribute</code></td>
            <td><code>[HttpGet("")]</code></td>
            <td>Nối với <code>[Route("attribute")]</code> ở controller</td>
        </tr>
        <tr>
            <td><code>/attribute/movie/3</code></td>
            <td><code>[HttpGet("movie/{id:int}")]</code></td>
            <td><code>:int</code> là route constraint, id phải là số</td>
        </tr>
        <tr>
            <td><code>/attribute/genre/Drama</code></td>
            <td><code>[HttpGet("genre/{genre:alpha}")]</code></td>
            <td><code>:alpha</code> chỉ nhận chữ cái</td>
        </tr>
        <tr>
            <td><code>/attribute/year/2010</code></td>
            <td><code>[HttpGet("year/{year:int:range(1990,2030)}")]</code></td>
            <td><code>:range</code> giới hạn giá trị</td>
        </tr>
        <tr>
            <td><code>/attribute/movie/abc</code></td>
            <td>không khớp route nào</td>
            <td>Trả về <strong>404</strong> vì vi phạm <code>:int</code></td>
        </tr>
    </tbody>
</table>

<h2>Thử ngay</h2>
<div class="d-flex flex-wrap gap-2">
    <a class="btn btn-primary" href="/attribute/movie/3">/attribute/movie/3</a>
    <a class="btn btn-primary" href="/attribute/genre/Drama">/attribute/genre/Drama</a>
    <a class="btn btn-primary" href="/attribute/year/2010">/attribute/year/2010</a>
    <a class="btn btn-outline-danger" href="/attribute/movie/abc">/attribute/movie/abc (404)</a>
</div>

<div class="alert alert-info mt-4">
    <strong>Conventional vs Attribute:</strong> conventional gom route vào một chỗ trong
    <code>Program.cs</code>; attribute khai báo tại chỗ nên dễ nhìn thấy URL của từng action,
    đặc biệt hữu ích với URL đặc biệt như <code>/attribute/movie/3</code>.
    Hai cách có thể dùng chung trong một project.
</div>

