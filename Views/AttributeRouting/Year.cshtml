@model IReadOnlyList<Movie>

@{
    ViewData["Title"] = "Attribute Routing - Year";
}

<h1>Phim theo năm phát hành</h1>
<p>
    URL <code>/attribute/year/2010</code> khớp với
    <code>[HttpGet("year/{year:int:range(1990,2030)}")]</code>.
    Nếu nhập năm ngoài khoảng 1990–2030, route sẽ không khớp và trả về <strong>404</strong>.
</p>

<p>Năm đang xem: <strong>@ViewData["Year"]</strong></p>
<p>URL hiện tại: <code>@Context.Request.Path</code></p>

@if (Model.Count == 0)
{
    <div class="alert alert-warning">Không có phim nào phát hành trong năm này.</div>
}
else
{
    <div class="row">
        @foreach (var movie in Model)
        {
            <div class="col-md-4">
                <partial name="_MovieCard" model="movie" />
            </div>
        }
    </div>
}

<a asp-controller="AttributeRouting" asp-action="Index">← Quay lại giải thích</a>
